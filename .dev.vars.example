# Copie para .dev.vars (NÃO versionar) e preencha.
# JSON completo da service account do GCP, em UMA linha.
GCP_SA_KEY={"type":"service_account","project_id":"studio-7861914720-de430","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"ddlab-data-bq@studio-7861914720-de430.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Projeto e dataset do BigQuery
GCP_PROJECT_ID=studio-7861914720-de430
BQ_DATASET=mcc_ddlab_google_ads
BQ_MCC_SUFFIX=9123420378

# Cloudflare Access (preencher depois de criar a Access Application).
# Em dev pode deixar vazio para pular a verificação de JWT — SÓ funciona assim
# porque ENVIRONMENT não é "production" aqui. Em produção (wrangler.toml define
# ENVIRONMENT=production), essas duas ausentes fazem a API recusar servir
# /api/* (500) em vez de abrir sem login. Configure via `wrangler secret put`
# ou dashboard → Settings → Runtime (não Builds) — ver DEPLOY.md passo 4.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# REFRESH_TOKEN: existe no código (worker/env.ts) mas NÃO é validado em nenhum
# lugar hoje — não depende dele para proteger /api/refresh (isso fica só atrás
# do Cloudflare Access). Deixe vazio; ver achado F3 da auditoria de segurança
# em docs/security-audit/ se for implementar de fato.
REFRESH_TOKEN=

# Análise IA (página "Análise IA"). Chave da conta Anthropic (console.anthropic.com/settings/keys),
# com billing próprio — é uma chamada de API paga, separada da assinatura do Claude Code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
